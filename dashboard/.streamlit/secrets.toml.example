# Copy to dashboard/.streamlit/secrets.toml for local dev (this file is gitignored).
# For Streamlit Community Cloud, paste these into Settings → Secrets.

# Direct Postgres connection — get from Supabase project → Settings → Database → Connection string.
# Format: postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL = "postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"

# Shared password for the dashboard's home-page gate.
APP_PASSWORD = "<pick-a-strong-password>"
